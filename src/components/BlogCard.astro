---
interface Props {
  tag: { label: string; color: string };
  title: string;
  desc: string;
  readTime: string;
  href: string;
  image: string;
  imageAlt: string;
  class?: string;
}

const { tag, title, desc, readTime, href, image, imageAlt, class: className = '' } = Astro.props;
---

<article class:list={['blog-card', className]}>
  <div class="card-img-wrap">
    <img
      src={image}
      alt={imageAlt}
      width="400"
      height="188"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="card-body">
    <span class={`pill pill-${tag.color}`}>{tag.label}</span>
    <h3 class="font-display font-bold" style="font-size:22px;margin-top:16px;line-height:1.2;color: var(--color-brand-primary);">{title}</h3>
    <p class="card-desc">{desc}</p>
    <div class="card-foot">
      <span class="readtime">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        {readTime}
      </span>
      <a href={href} class="readlink">
        Read Article
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </div>
</article>

---
/**
 * Legacy marketing landing — visual clone of https://ablefamilydental.com/smile/
 * Intentionally does NOT use the new Able design system.
 * Internal links point at the new site routes.
 */
const bookingUrl =
  'https://can3.recallmax.com/rsm/request/public/bookOnline/patient/layout.html?a=t4ttSwyQ0NkQv9DLpa1kYRBbE_cNvZb54X';
const jotformUrl = 'https://form.jotform.com/213275643171251';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your Smile, Our Priority. | Able Family Dental</title>
    <meta
      name="description"
      content="Serving Lethbridge Families Since 2006. Comprehensive dental care for every stage of life — family dentistry, Invisalign®, dental implants, and IV sedation."
    />
    <link rel="canonical" href="https://ablefamilydental.com/smile/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <meta property="og:title" content="Your Smile, Our Priority. | Able Family Dental" />
    <meta property="og:url" content="https://ablefamilydental.com/smile/" />
    <meta property="og:image" content="https://ablefamilydental.com/images/marketing/smile-hero-exterior.jpg" />
    <meta name="theme-color" content="#008080" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <style is:global>
      /* Reset — isolate from any leftover styles */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
      }
      body.smile-landing {
        margin: 0;
        padding: 0;
        font-family: Roboto, Arial, Helvetica, sans-serif;
        color: #333;
        background: #fff;
        -webkit-font-smoothing: antialiased;
      }
      a {
        color: inherit;
      }
      img {
        max-width: 100%;
        height: auto;
      }

      /* ===== Top notification (CDS) ===== */
      .smile-notification {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1031;
        background-color: #008080;
        height: 30px;
        padding: 0;
        display: flex;
        align-items: center;
      }
      .smile-notification .container {
        width: 100%;
        max-width: 1140px;
        margin: 0 auto;
        padding: 0 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
      }
      .smile-notification p {
        margin: 0;
        font-size: 12px;
        font-weight: 700;
        color: #fff;
        line-height: normal;
        font-family: Arial, Helvetica, sans-serif;
      }
      .smile-notification a {
        color: #fff;
        text-decoration: none;
      }
      @media (max-width: 767px) {
        .smile-notification .desktop-only {
          display: none;
        }
        .smile-notification .container {
          justify-content: center;
        }
        .smile-notification p {
          text-align: center;
        }
      }

      /* ===== Sticky white nav (CDS simplified) ===== */
      .smile-nav {
        position: fixed;
        top: 30px;
        left: 0;
        right: 0;
        z-index: 1030;
        background: #fff;
        box-shadow: 0 2px 20px 4px rgba(0, 0, 0, 0.1);
      }
      .smile-nav .container {
        max-width: 1140px;
        margin: 0 auto;
        padding: 12px 15px;
        display: flex;
        align-items: center;
        gap: 16px;
      }
      .smile-nav .brand img {
        display: block;
        max-height: 48px;
        width: auto;
      }
      .smile-nav .nav-links {
        display: none;
        list-style: none;
        margin: 0 auto;
        padding: 0;
        gap: 8px 18px;
        align-items: center;
      }
      .smile-nav .nav-links a {
        text-decoration: none;
        text-transform: uppercase;
        font-size: 13px;
        font-weight: 500;
        color: #212529;
        letter-spacing: 0.02em;
        white-space: nowrap;
      }
      .smile-nav .nav-links a:hover {
        color: #008080;
      }
      .smile-nav .phone {
        margin-left: auto;
        color: #008080;
        font-weight: 700;
        text-decoration: none;
        font-size: 15px;
        white-space: nowrap;
      }
      .smile-nav .book-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #ff0000 !important;
        color: #fff !important;
        font-weight: 700;
        font-size: 14px;
        text-decoration: none;
        text-transform: none;
        padding: 12px 22px;
        border-radius: 4px;
        white-space: nowrap;
      }
      .smile-nav .book-btn:hover {
        filter: brightness(0.92);
      }
      @media (min-width: 992px) {
        .smile-nav .nav-links {
          display: flex;
        }
        .smile-nav .container {
          padding-top: 18px;
          padding-bottom: 18px;
        }
      }
      @media (max-width: 991px) {
        .smile-nav .phone {
          display: none;
        }
      }

      /* Offset fixed chrome */
      .smile-page-body {
        padding-top: 102px;
      }
      @media (min-width: 992px) {
        .smile-page-body {
          padding-top: 114px;
        }
      }

      /* ===== Appointment section (ported) ===== */
      .afd-appointment-section {
        background: #f7fbfb;
        padding: 80px 20px;
        font-family: Arial, Helvetica, sans-serif;
      }
      .afd-appointment-wrap {
        max-width: 1280px;
        margin: auto;
      }
      .afd-appointment-header {
        max-width: 900px;
        margin: 0 auto 55px;
        text-align: center;
      }
      .afd-eyebrow {
        color: #008991;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin: 0 0 14px;
      }
      .afd-appointment-header h2 {
        font-size: clamp(38px, 5vw, 56px);
        line-height: 1.1;
        margin: 0 0 20px;
        color: #111;
        font-weight: 800;
        font-family: Arial, Helvetica, sans-serif;
      }
      .afd-appointment-header > p {
        font-size: 20px;
        line-height: 1.7;
        color: #555;
        max-width: 760px;
        margin: 0 auto;
      }
      .afd-appointment-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 35px;
        align-items: stretch;
      }
      .afd-form-card,
      .afd-offer-card {
        background: #fff;
        border-radius: 28px;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.08);
      }
      .afd-form-card {
        padding: 22px;
        overflow: hidden;
      }
      .afd-form-card iframe {
        width: 100%;
        height: 670px;
        border: none;
        border-radius: 18px;
        display: block;
      }
      .afd-offer-card {
        padding: 40px 36px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        text-align: center;
      }
      .afd-offer-label {
        margin: 0;
        color: #008991;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 14px;
      }
      .afd-offer-card h3 {
        font-size: 34px;
        line-height: 1.15;
        margin: 18px 0;
        color: #111;
        font-weight: 800;
        font-family: Arial, Helvetica, sans-serif;
      }
      .afd-offer-card img {
        width: 260px;
        max-width: 100%;
        margin: 10px auto 22px;
        display: block;
        height: auto;
      }
      .afd-promo-code {
        background: linear-gradient(135deg, #008991, #00a3ad);
        color: #ffffff;
        border-radius: 18px;
        padding: 18px 20px;
        margin: 0 auto 28px;
        max-width: 310px;
        width: 100%;
        box-shadow: 0 12px 28px rgba(0, 137, 145, 0.22);
      }
      .afd-promo-code span {
        display: block;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 8px;
      }
      .afd-promo-code strong {
        display: block;
        font-size: 28px;
        letter-spacing: 2px;
        font-weight: 800;
      }
      .afd-offer-copy {
        font-size: 18px;
        line-height: 1.7;
        color: #555;
        margin: 0 0 28px;
      }
      .afd-benefits {
        background: #eef9fa;
        border-radius: 18px;
        padding: 18px;
        font-size: 15px;
        line-height: 1.6;
        color: #444;
        text-align: left;
      }
      .afd-benefit {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        margin-bottom: 8px;
      }
      .afd-benefit:last-child {
        margin-bottom: 0;
      }
      .afd-benefit svg {
        width: 18px;
        height: 18px;
        min-width: 18px;
        margin-top: 3px;
        color: #008991;
      }
      .afd-disclaimer {
        font-size: 13px;
        color: #777;
        margin: 24px 0 0;
        line-height: 1.5;
      }
      @media (max-width: 900px) {
        .afd-appointment-section {
          padding: 60px 18px;
        }
        .afd-appointment-grid {
          grid-template-columns: 1fr;
          gap: 28px;
        }
        .afd-form-card,
        .afd-offer-card {
          border-radius: 24px;
        }
        .afd-form-card {
          padding: 16px;
        }
        .afd-form-card iframe {
          height: 720px;
          border-radius: 16px;
        }
        .afd-offer-card {
          padding: 34px 24px;
        }
      }
      @media (max-width: 600px) {
        .afd-appointment-section {
          padding: 50px 16px;
        }
        .afd-appointment-header {
          margin-bottom: 36px;
        }
        .afd-eyebrow {
          font-size: 13px;
        }
        .afd-appointment-header h2 {
          font-size: 36px;
        }
        .afd-appointment-header > p {
          font-size: 17px;
          line-height: 1.6;
        }
        .afd-form-card {
          padding: 12px;
          border-radius: 20px;
        }
        .afd-form-card iframe {
          height: 760px;
          border-radius: 14px;
        }
        .afd-offer-card {
          padding: 30px 20px;
          border-radius: 20px;
        }
        .afd-offer-card h3 {
          font-size: 28px;
        }
        .afd-promo-code {
          padding: 16px 18px;
          border-radius: 16px;
        }
        .afd-promo-code strong {
          font-size: 24px;
        }
        .afd-offer-copy {
          font-size: 16px;
        }
        .afd-benefits {
          font-size: 14px;
          padding: 16px;
        }
      }

      /* ===== Book consultation banner (CDS) ===== */
      .smile-book-banner {
        height: 280px;
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
      }
      .smile-book-banner .container {
        max-width: 1140px;
        width: 100%;
        margin: 0 auto;
        padding: 0 5%;
      }
      .smile-book-banner a {
        display: inline-block;
        position: relative;
        width: auto;
        padding-right: 30px;
        color: #000;
        font-size: 34px;
        font-weight: 700;
        text-decoration: none;
        font-family: Roboto, Arial, sans-serif;
      }
      .smile-book-banner a::after {
        content: '';
        width: 11px;
        height: 20px;
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        background-image: url("data:image/svg+xml,%3Csvg width='11' height='20' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M.268 1.552a.904.904 0 0 1 0-1.286.922.922 0 0 1 1.297 0l9.167 9.091a.904.904 0 0 1 0 1.286l-9.167 9.09a.922.922 0 0 1-1.297 0 .904.904 0 0 1 0-1.285L8.681 10 .268 1.552z' fill='%23008080' fill-rule='nonzero'/%3E%3C/svg%3E");
        background-repeat: no-repeat;
        background-position: center;
      }
      @media (max-width: 768px) {
        .smile-book-banner a {
          font-size: 30px;
        }
      }

      /* ===== Footer (CDS) ===== */
      .smile-footer {
        background: #1f1f1f;
        color: #fff;
        font-family: Roboto, Arial, sans-serif;
      }
      .smile-footer .container {
        max-width: 1140px;
        margin: 0 auto;
        padding: 50px 15px;
        display: grid;
        grid-template-columns: 1.2fr 0.8fr 1.4fr 1.2fr;
        gap: 30px;
      }
      .smile-footer a {
        color: #fff;
        text-decoration: none;
      }
      .smile-footer a:hover {
        text-decoration: underline;
      }
      .smile-footer .logo {
        display: inline-block;
        margin-bottom: 20px;
      }
      .smile-footer .logo img {
        max-width: 144px;
        height: auto;
      }
      .smile-footer .social {
        margin-top: 10px;
        font-size: 14px;
        line-height: 1.9;
      }
      .smile-footer .social a {
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }
      .smile-footer .links {
        font-size: 16px;
        line-height: 2;
      }
      .smile-footer .contact p,
      .smile-footer .hours p {
        font-size: 14px;
        color: #fff;
        margin: 0 0 10px;
        line-height: 1.5;
      }
      .smile-footer table {
        border-collapse: collapse;
        font-size: 14px;
        color: #fff;
      }
      .smile-footer td {
        padding: 2px 10px 2px 0;
        vertical-align: top;
      }
      .smile-footer .hours-note {
        font-size: 12px;
        color: #ccc;
        margin-top: 10px;
      }
      .smile-footer-bottom {
        background: #181818;
        padding: 16px 15px;
      }
      .smile-footer-bottom .container {
        max-width: 1140px;
        margin: 0 auto;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 10px;
        font-size: 12px;
        color: #aaa;
        grid-template-columns: none;
      }
      .smile-footer-bottom a {
        color: #aaa;
      }
      @media (max-width: 900px) {
        .smile-footer .container {
          grid-template-columns: 1fr 1fr;
        }
      }
      @media (max-width: 600px) {
        .smile-footer .container {
          grid-template-columns: 1fr;
          padding-top: 35px;
          padding-bottom: 35px;
        }
      }
    </style>
  </head>
  <body class="smile-landing">
    <!-- Notification bar -->
    <div class="smile-notification">
      <div class="container">
        <p class="desktop-only">We are accepting new patients!</p>
        <p>
          Evening and weekend appointments available
          <span> | <a href="tel:403-327-7202">403-327-7202</a></span>
        </p>
      </div>
    </div>

    <!-- Header -->
    <nav class="smile-nav" aria-label="Primary">
      <div class="container">
        <a class="brand" href="/" aria-label="Able Family Dental home">
          <img src="/images/marketing/able-logo-header-140.png" alt="Able Family Dental" width="140" height="88" />
        </a>
        <ul class="nav-links">
          <li><a href="/about/our-clinic/">About</a></li>
          <li><a href="/services/">Dental Services</a></li>
          <li><a href="/new-patients/">Patient Info</a></li>
          <li><a href="/contact/">Contact Us</a></li>
        </ul>
        <a class="phone" href="tel:403-327-7202">403-327-7202</a>
        <a class="book-btn" href={bookingUrl} target="_blank" rel="noopener noreferrer">BOOK NOW</a>
      </div>
    </nav>

    <div class="smile-page-body">
      <!-- ===== HERO (exact live markup) ===== -->
      <section
        style="width: 100%; background: linear-gradient(135deg,#ffffff 0%,#f7fbfb 55%,#e6f5f6 100%); padding: 80px 20px; font-family: Arial,Helvetica,sans-serif; overflow: hidden;"
      >
        <div style="max-width: 1200px; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; gap: 55px;">
          <div style="flex: 1 1 500px; min-width: 300px;">
            <div
              style="display: inline-block; background: #e4f5f6; color: #007b83; border: 1px solid #b7e4e7; padding: 10px 18px; border-radius: 999px; font-size: 15px; font-weight: bold; margin-bottom: 22px;"
            >
              Serving Lethbridge Families Since 2006
            </div>

            <h1
              style="font-size: clamp(40px,5vw,66px); line-height: 1.05; margin: 0 0 24px; color: #111; font-weight: 800; letter-spacing: -1px;"
            >
              Comprehensive Dental Care for Every Stage of Life
            </h1>

            <p style="font-size: 20px; line-height: 1.6; color: #333; margin: 0 0 34px; max-width: 650px;">
              Proudly caring for Lethbridge families with compassionate, personalized dental care. From routine
              preventive care to Invisalign®, dental implants, and IV sedation, our team is here to help you smile with
              confidence.
            </p>

            <div style="display: flex; flex-wrap: wrap; gap: 16px; margin-bottom: 34px; align-items: center;">
              <a
                style="display: inline-flex; align-items: center; justify-content: center; height: 58px; padding: 0 34px; background: #008991; color: #ffffff; border-radius: 999px; text-decoration: none; font-weight: bold; font-size: 16px; box-shadow: 0 12px 28px rgba(0,137,145,.22); white-space: nowrap;"
                href={bookingUrl}
                target="_blank"
                rel="noopener"
              >
                Book an Appointment
              </a>

              <a
                style="display: inline-flex; align-items: center; justify-content: center; height: 58px; padding: 0 34px; background: #ffffff; color: #008991; border: 2px solid #008991; border-radius: 999px; text-decoration: none; font-weight: bold; font-size: 16px; white-space: nowrap;"
                href="tel:+15877017074"
              >
                Call Now
              </a>
            </div>

            <div style="display: flex; flex-wrap: wrap; gap: 12px; max-width: 650px;">
              <span
                style="display: inline-flex; align-items: center; justify-content: center; min-height: 46px; background: #fff; border: 1px solid #b7e4e7; padding: 0 18px; border-radius: 999px; font-weight: bold;"
                >Family Dentistry</span
              >
              <span
                style="display: inline-flex; align-items: center; justify-content: center; min-height: 46px; background: #fff; border: 1px solid #b7e4e7; padding: 0 18px; border-radius: 999px; font-weight: bold;"
                >Invisalign® &amp; Braces</span
              >
              <span
                style="display: inline-flex; align-items: center; justify-content: center; min-height: 46px; background: #fff; border: 1px solid #b7e4e7; padding: 0 18px; border-radius: 999px; font-weight: bold;"
                >Dental Implants</span
              >
              <span
                style="display: inline-flex; align-items: center; justify-content: center; min-height: 46px; background: #fff; border: 1px solid #b7e4e7; padding: 0 18px; border-radius: 999px; font-weight: bold;"
                >IV Sedation</span
              >
            </div>
          </div>

          <div style="flex: 1 1 430px; min-width: 300px;">
            <img
              decoding="async"
              style="width: 100%; height: auto; display: block; border-radius: 30px; border: 8px solid #fff; box-shadow: 0 22px 55px rgba(0,0,0,.16);"
              src="/images/marketing/smile-hero-exterior.jpg"
              alt="Able Family Dental exterior"
              width="1200"
              height="899"
            />

            <div style="margin-top: 20px; display: flex; flex-wrap: wrap; gap: 14px;">
              <div
                style="flex: 1 1 190px; background: #fff; border-left: 6px solid #008991; border-radius: 18px; padding: 22px 20px; box-shadow: 0 12px 30px rgba(0,0,0,.10);"
              >
                <strong style="display: block; font-size: 18px; color: #111; margin-bottom: 8px;">Now Accepting CDCP</strong>
                <span style="font-size: 14px; color: #444; line-height: 1.5;">Canadian Dental Care Plan</span>
              </div>

              <div
                style="flex: 1 1 190px; background: #008991; color: #fff; border-radius: 18px; padding: 22px 20px; box-shadow: 0 12px 30px rgba(0,137,145,.25);"
              >
                <strong style="display: block; font-size: 18px; margin-bottom: 8px;"
                  >Orthodontic Care Now Available at Able</strong
                >
                <span style="font-size: 14px; line-height: 1.5;"
                  >Traditional Braces &amp; Invisalign, schedule a consultation today.</span
                >
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ===== REQUEST + PROMO ===== -->
      <section class="afd-appointment-section" id="request">
        <div class="afd-appointment-wrap">
          <div class="afd-appointment-header">
            <p class="afd-eyebrow">Now Accepting New Patients</p>
            <h2>Request an Appointment</h2>
            <p>
              Whether you’re looking for a new family dentist, interested in Invisalign®, dental implants, or simply have
              questions about your oral health, our team is here to help.
            </p>
            <p style="color: black; margin-top: 12px;">
              Book your appointment
              <a href={bookingUrl} style="color: black; text-decoration: underline;" target="_blank" rel="noopener"
                >online</a
              >
              or request an appointment below.
            </p>
          </div>

          <div class="afd-appointment-grid">
            <div class="afd-form-card">
              <iframe
                id="JotFormIFrame-213275643171251"
                title="ABLE FAMILY DENTAL CONTACT US FORM"
                allowtransparency="true"
                allow="geolocation; microphone; camera; fullscreen; payment"
                src={jotformUrl}
                frameborder="0"
                scrolling="yes"></iframe>
              <script is:inline src="https://cdn.jotfor.ms/s/umd/latest/for-form-embed-handler.js"></script>
              <script is:inline>
                window.jotformEmbedHandler(
                  "iframe[id='JotFormIFrame-213275643171251']",
                  'https://form.jotform.com/',
                );
              </script>
            </div>

            <div class="afd-offer-card">
              <p class="afd-offer-label">New Patient Gift</p>
              <h3>
                Complimentary<br />
                Wicked White PRO<br />
                Whitening Pen
              </h3>
              <img
                decoding="async"
                src="/images/marketing/wicked-white-pro-whitening-pen.jpg"

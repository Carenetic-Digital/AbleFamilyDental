---
/**
 * Legacy marketing landing — visual clone of https://ablefamilydental.com/smile/
 * Intentionally does NOT use the new Able design system.
 * Internal links point at the new site routes.
 */
const bookingUrl =
  'https://can3.recallmax.com/rsm/request/public/bookOnline/patient/layout.html?a=t4ttSwyQ0NkQv9DLpa1kYRBbE_cNvZb54X';
const jotformUrl = 'https://hipaa.jotform.com/213275643171251';
const year = new Date().getFullYear();
const smileSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dentist',
  name: 'Able Family Dental',
  url: 'https://ablefamilydental.com/smile/',
  telephone: '+1-403-327-7202',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '511 5th Street South',
    addressLocality: 'Lethbridge',
    addressRegion: 'AB',
    addressCountry: 'CA',
  },
  image: 'https://ablefamilydental.com/images/marketing/smile-hero-exterior.jpg',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your Smile, Our Priority. | Able Family Dental</title>
    <meta
      name="description"
      content="Serving Lethbridge Families Since 2006. Comprehensive dental care for every stage of life — family dentistry, Invisalign®, dental implants, and IV sedation."
    />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href="https://ablefamilydental.com/smile/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Able Family Dental" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:title" content="Your Smile, Our Priority. | Able Family Dental" />
    <meta
      property="og:description"
      content="Serving Lethbridge Families Since 2006. Comprehensive dental care for every stage of life — family dentistry, Invisalign®, dental implants, and IV sedation."
    />
    <meta property="og:url" content="https://ablefamilydental.com/smile/" />
    <meta property="og:image" content="https://ablefamilydental.com/images/marketing/smile-hero-exterior.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Your Smile, Our Priority. | Able Family Dental" />
    <meta
      name="twitter:description"
      content="Serving Lethbridge Families Since 2006. Comprehensive dental care for every stage of life — family dentistry, Invisalign®, dental implants, and IV sedation."
    />
    <meta name="twitter:image" content="https://ablefamilydental.com/images/marketing/smile-hero-exterior.jpg" />
    <meta name="theme-color" content="#008080" />
    <script type="application/ld+json" set:html={JSON.stringify(smileSchema)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700|Roboto+Condensed:700&display=swap" rel="stylesheet" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <!-- Magenta Schedule Appointment side tab (same widget as live site) -->
    <script
      is:inline
      src="https://cdn.maxassist.com/scripts/maxassist-booking.js"
      data-server-url="https://can3.recallmax.com/rsm/request/public/bookOnline/patient/layout.html?a=t4ttSwyQ0NkQv9DLpa1kYRBbE_cNvZb54X"
    ></script>
    <style is:global>
      /* Reset — isolate from any leftover styles */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
      }
      body.smile-landing {
        margin: 0;
        padding: 0;
        font-family: Roboto, Arial, Helvetica, sans-serif;
        color: #333;
        background: #fff;
        -webkit-font-smoothing: antialiased;
      }
      a {
        color: inherit;
      }
      img {
        max-width: 100%;
        height: auto;
      }

      /* ===== Top notification (CDS) ===== */
      .smile-notification {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1031;
        background-color: #008080;
        height: 30px;
        padding: 0;
        display: flex;
        align-items: center;
      }
      .smile-notification .container {
        width: 100%;
        max-width: 1140px;
        margin: 0 auto;
        padding: 0 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
      }
      .smile-notification p {
        margin: 0;
        font-size: 12px;
        font-weight: 700;
        color: #fff;
        line-height: normal;
        font-family: Arial, Helvetica, sans-serif;
      }
      .smile-notification a {
        color: #fff;
        text-decoration: none;
      }
      @media (max-width: 767px) {
        .smile-notification .desktop-only {
          display: none;
        }
        .smile-notification .container {
          justify-content: center;
        }
        .smile-notification p {
          text-align: center;
        }
      }

      /* ===== Sticky white nav (CDS match) ===== */
      .smile-nav {
        position: fixed;
        top: 30px;
        left: 0;
        right: 0;
        z-index: 1030;
        background: #fff;
        box-shadow: 0 2px 20px 4px rgba(0, 0, 0, 0.1);
      }
      .smile-nav .container {
        max-width: 1140px;
        margin: 0 auto;
        padding: 12px 15px;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .smile-nav .brand {
        display: inline-flex;
        align-items: center;
        flex-shrink: 0;
        padding-left: 0;
      }
      .smile-nav .brand img {
        display: block;
        max-width: 200px;
        max-height: 96px;
        width: auto;
        height: auto;
      }
      .smile-nav .nav-links {
        display: none;
        list-style: none;
        margin: 0 auto;
        padding: 0;
        align-items: center;
      }
      .smile-nav .nav-links li {
        margin: 0;
      }
      .smile-nav .nav-links a {
        display: block;
        text-decoration: none;
        text-transform: uppercase;
        font-family: acumin-pro-semi-condensed, Roboto, Arial, sans-serif;
        font-style: normal;
        font-weight: 400;
        font-size: 14px;
        letter-spacing: normal;
        color: #000 !important;
        white-space: nowrap;
        padding: 0 1rem !important;
      }
      .smile-nav .nav-links a:hover {
        color: #008080 !important;
      }
      .smile-nav .phone {
        margin-left: auto;
        color: #008080 !important;
        text-decoration: none;
        white-space: nowrap;
        display: none;
      }
      .smile-nav .phone .phone-number__text {
        font-family: acumin-pro-condensed, "Roboto Condensed", Arial Narrow, Arial, sans-serif;
        font-weight: 700;
        font-size: 26px;
        line-height: 1;
      }
      .smile-nav .book-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background-color: #ff0000 !important;
        color: #fff !important;
        font-family: Roboto, sans-serif;
        font-weight: 700 !important;
        font-size: 14px !important;
        text-decoration: none;
        text-transform: none !important;
        border: 0 !important;
        border-radius: 4px;
        padding: 14.5px 11.5px !important;
        white-space: nowrap;
        line-height: 1.2;
        transition: background-color 0.25s ease-out, color 0.25s ease-out;
      }
      .smile-nav .book-btn:hover {
        background-color: #e60000 !important;
        color: #fff !important;
      }
      @media (min-width: 992px) {
        .smile-nav .nav-links {
          display: flex;
        }
        .smile-nav .phone {
          display: inline-block;
        }
        .smile-nav .container {
          padding-top: 25px;
          padding-bottom: 25px;
        }
      }

      /* Offset fixed chrome */
      .smile-page-body {
        padding-top: 150px;
      }
      @media (min-width: 992px) {
        .smile-page-body {
          padding-top: 176px;
        }
      }

      /* ===== Appointment section (ported) ===== */
      .afd-appointment-section {
        background: #f7fbfb;
        padding: 80px 20px;
        font-family: Arial, Helvetica, sans-serif;
      }
      .afd-appointment-wrap {
        max-width: 1280px;
        margin: auto;
      }
      .afd-appointment-header {
        max-width: 900px;
        margin: 0 auto 55px;
        text-align: center;
      }
      .afd-eyebrow {
        color: #008991;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin: 0 0 14px;
      }
      .afd-appointment-header h2 {
        font-size: clamp(38px, 5vw, 56px);
        line-height: 1.1;
        margin: 0 0 20px;
        color: #111;
        font-weight: 800;
        font-family: Arial, Helvetica, sans-serif;
      }
      .afd-appointment-header > p {
        font-size: 20px;
        line-height: 1.7;
        color: #555;
        max-width: 760px;
        margin: 0 auto;
      }
      .afd-appointment-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 35px;
        align-items: stretch;
      }
      .afd-form-card,
      .afd-offer-card {
        background: #fff;
        border-radius: 28px;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.08);
      }
      .afd-form-card {
        padding: 22px;
        overflow: hidden;
      }
      .afd-form-card iframe {
        width: 100%;
        height: 670px;
        border: none;
        border-radius: 18px;
        display: block;
      }
      .afd-offer-card {
        padding: 40px 36px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        text-align: center;
      }
      .afd-offer-label {
        margin: 0;
        color: #008991;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-size: 14px;
      }
      .afd-offer-card h3 {
        font-size: 34px;
        line-height: 1.15;
        margin: 18px 0;
        color: #111;
        font-weight: 800;
        font-family: Arial, Helvetica, sans-serif;
      }
      .afd-offer-card img {
        width: 260px;
        max-width: 100%;
        margin: 10px auto 22px;
        display: block;
        height: auto;
      }
      .afd-promo-code {
        background: linear-gradient(135deg, #008991, #00a3ad);
        color: #ffffff;
        border-radius: 18px;
        padding: 18px 20px;
        margin: 0 auto 28px;
        max-width: 310px;
        width: 100%;
        box-shadow: 0 12px 28px rgba(0, 137, 145, 0.22);
      }
      .afd-promo-code span {
        display: block;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 8px;
      }
      .afd-promo-code strong {
        display: block;
        font-size: 28px;
        letter-spacing: 2px;
        font-weight: 800;
      }
      .afd-offer-copy {
        font-size: 18px;
        line-height: 1.7;
        color: #555;
        margin: 0 0 28px;
      }
      .afd-benefits {
        background: #eef9fa;
        border-radius: 18px;
        padding: 18px;
        font-size: 15px;
        line-height: 1.6;
        color: #444;
        text-align: left;
      }
      .afd-benefit {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        margin-bottom: 8px;
      }
      .afd-benefit:last-child {
        margin-bottom: 0;
      }
      .afd-benefit svg {
        width: 18px;
        height: 18px;
        min-width: 18px;
        margin-top: 3px;
        color: #008991;
      }
      .afd-disclaimer {
        font-size: 13px;
        color: #777;
        margin: 24px 0 0;
        line-height: 1.5;
      }
      @media (max-width: 900px) {
        .afd-appointment-section {
          padding: 60px 18px;
        }
        .afd-appointment-grid {
          grid-template-columns: 1fr;
          gap: 28px;
        }
        .afd-form-card,
        .afd-offer-card {
          border-radius: 24px;
        }
        .afd-form-card {
          padding: 16px;
        }
        .afd-form-card iframe {
          height: 720px;
          border-radius: 16px;
        }
        .afd-offer-card {
          padding: 34px 24px;
        }
      }
      @media (max-width: 600px) {
        .afd-appointment-section {
          padding: 50px 16px;
        }
        .afd-appointment-header {
          margin-bottom: 36px;
        }
        .afd-eyebrow {
          font-size: 13px;
        }
        .afd-appointment-header h2 {
          font-size: 36px;
        }
        .afd-appointment-header > p {
          font-size: 17px;
          line-height: 1.6;
        }
        .afd-form-card {
          padding: 12px;
          border-radius: 20px;
        }
        .afd-form-card iframe {
          height: 760px;
          border-radius: 14px;
        }
        .afd-offer-card {
          padding: 30px 20px;
          border-radius: 20px;
        }
        .afd-offer-card h3 {
          font-size: 28px;
        }
        .afd-promo-code {
          padding: 16px 18px;
          border-radius: 16px;
        }
        .afd-promo-code strong {
          font-size: 24px;
        }
        .afd-offer-copy {
          font-size: 16px;
        }
        .afd-benefits {
          font-size: 14px;
          padding: 16px;
        }
      }

      /* ===== Book consultation banner (CDS) ===== */
      .smile-book-banner {
        height: 280px;
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
      }
      .smile-book-banner .container {
        max-width: 1140px;
        width: 100%;
        margin: 0 auto;
        padding-left: 15px;
        padding-right: 15px;
        text-align: left;
      }
      /* Matches CDS .text-icon.accent */
      .smile-book-banner a.text-icon.accent {
        display: inline-block;
        position: relative;
        width: auto;
        padding-top: 15px;
        padding-right: 30px;
        color: #000;
        font-size: 34px;
        font-weight: 700;
        line-height: 1.2;
        margin-bottom: 0;
        text-decoration: none;
        font-family: Roboto, Arial, sans-serif;
      }
      /* Teal bar above CTA */
      .smile-book-banner a.text-icon.accent::before {
        content: '';
        position: absolute;
        width: 140px;
        height: 5px;
        top: 0;
        left: 0;
        border-radius: 2.5px;
        background-color: #008080;
      }
      .smile-book-banner a.text-icon.accent .text-icon__icon {
        width: 11px;
        height: 20px;
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        margin-top: 7.5px;
        background-image: url("data:image/svg+xml,%3Csvg width='11' height='20' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M.268 1.552a.904.904 0 0 1 0-1.286.922.922 0 0 1 1.297 0l9.167 9.091a.904.904 0 0 1 0 1.286l-9.167 9.09a.922.922 0 0 1-1.297 0 .904.904 0 0 1 0-1.285L8.681 10 .268 1.552z' fill='%23008080' fill-rule='nonzero'/%3E%3C/svg%3E");
        background-repeat: no-repeat;
        background-position: center;
      }
      @media (max-width: 768px) {
        .smile-book-banner a.text-icon.accent {
          font-size: 30px;
        }
        .smile-book-banner .container {
          padding-left: 35px;
          padding-right: 35px;
        }
      }

      /* ===== MaxAssist purple side tab — match live height ===== */
      .MaxAssistBookButton {
        min-height: 150px !important;
        padding: 28px 18px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
      }
      .MaxAssistBookButton .icon {
        height: 56px !important;
        display: flex !important;
        align-items: center !important;
      }
      .MaxAssistBookButton .content {
        font-size: 20px !important;
        line-height: 1.25 !important;
        display: flex !important;
        flex-direction: column !important;
        justify-content: center !important;
      }
      .MaxAssistBookButton .content div {
        font-size: 20px !important;
        line-height: 1.25 !important;
      }

      /* ===== Footer (CDS) ===== */
      .smile-footer {
        color: #fff;
        font-family: Roboto, Arial, sans-serif;
      }
      .smile-footer .footer-main {
        background: #1f1f1f;
        position: relative;
      }
      .smile-footer .footer-main-inner {
        max-width: 1140px;
        margin: 0 auto;
        padding: 0 15px;
      }
      .smile-footer .footer-emergency-mobile {
        display: none;
        padding: 50px 0 0;
      }
      .smile-footer .footer-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.7fr 1.5fr 1fr;
        gap: 0;
        align-items: start;
      }
      .smile-footer .footer-col {
        padding: 50px 20px 50px 0;
      }
      .smile-footer .footer-col-cta {
        background: #181818;
        padding: 50px 20px;
        text-align: right;
        min-height: 100%;
        display: flex;
        align-items: flex-start;
        justify-content: flex-end;
      }
      .smile-footer a {
        color: #fff;
        text-decoration: none;
      }
      .smile-footer a:hover {
        text-decoration: underline;
      }
      .smile-footer .logo {
        display: inline-block;
        margin-bottom: 20px;
      }
      .smile-footer .logo img {
        max-width: 144px;
        height: auto;
      }
      .smile-footer .social {
        margin-top: 10px;
        font-size: 14px;
        line-height: 1.9;
      }
      .smile-footer .social a {
        display: inline;
      }
      .smile-footer .links {
        font-size: 16px;
        line-height: 2;
        margin: 0;
      }
      .smile-footer .contact p,
      .smile-footer .hours-block p {
        font-size: 14px;
        color: #fff;
        margin: 0 0 10px;
        line-height: 1.5;
      }
      .smile-footer table {
        border-collapse: collapse;
        font-size: 14px;
        color: #fff;
        margin-bottom: 10px;
      }
      .smile-footer td {
        padding: 2px 10px 2px 0;
        vertical-align: top;
      }
      .smile-footer .hours-note {
        font-size: 13px;
        color: #fff;
        margin: 0 0 16px;
      }
      .smile-footer .privacy-link {
        font-size: 14px;
        font-style: italic;
      }
      .smile-footer .btn-emergency {
        display: inline-block;
        background-color: #008080;
        color: #fff !important;
        font-family: Roboto, sans-serif;
        font-weight: 700;
        font-size: 14px !important;
        text-decoration: none !important;
        text-transform: none;
        border: 0;
        border-radius: 4px;
        padding: 19.5px 46px;
        line-height: 1.2;
        transition: background-color 0.25s ease-out;
        text-align: center;
      }
      .smile-footer .btn-emergency:hover {
        background-color: #009d9d;
        color: #fff !important;
        text-decoration: none !important;
      }
      .smile-footer-bottom {
        background: #fff;
        padding: 16px 15px;
      }
      .smile-footer-bottom .container {
        max-width: 1140px;
        margin: 0 auto;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
      }
      .smile-footer-bottom .copyright-text {
        margin: 0;
        font-size: 14px;
        color: #181818;
      }
      .smile-footer-bottom .footer-managing {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 15px;
      }
      .smile-footer-bottom .footer-managing__text {
        font-size: 10px;
        color: #181818;
        line-height: 1.3;
        text-align: right;
      }
      .smile-footer-bottom .footer-managing__img img {
        display: block;
        max-width: 120px;
        height: auto;
      }
      @media (max-width: 991px) {
        .smile-footer .footer-grid {
          grid-template-columns: 1fr 1fr;
        }
        .smile-footer .footer-col-cta {
          display: none;
        }
        .smile-footer .footer-emergency-mobile {
          display: block;
        }
      }
      @media (max-width: 600px) {
        .smile-footer .footer-grid {
          grid-template-columns: 1fr;
        }
        .smile-footer .footer-col {
          padding: 30px 0;
        }
        .smile-footer-bottom .container {
          flex-direction: column;
          align-items: flex-start;
        }
        .smile-footer-bottom .footer-managing {
          justify-content: flex-start;
        }
      }
    </style>
  </head>
  <body class="smile-landing">
    <!-- Notification bar -->
    <div class="smile-notification">
      <div class="container">
        <p class="desktop-only">We are accepting new patients!</p>
        <p>
          Evening and weekend appointments available
          <span> | <a href="tel:403-327-7202">403-327-7202</a></span>
        </p>
      </div>
    </div>

    <!-- Header -->
    <nav class="smile-nav" aria-label="Primary">
      <div class="container">
        <a class="brand" href="/" aria-label="Able Family Dental home">
          <img src="/images/logos/able-family-dental-logo-vertical.webp" alt="Able Family Dental" width="200" height="126" />
        </a>
        <ul class="nav-links">
          <li><a href="/about/our-clinic/">About</a></li>
          <li><a href="/services/">Dental Services</a></li>
          <li><a href="/new-patients/">Patient Info</a></li>
          <li><a href="/contact/">Contact Us</a></li>
        </ul>
        <a class="phone" href="tel:403-327-7202" id="phone-number">
          <span class="phone-number__text">403-327-7202</span>
        </a>
        <a class="book-btn" id="book-button" href={bookingUrl} target="_blank" rel="noopener noreferrer">BOOK NOW</a>
      </div>
    </nav>

    <div class="smile-page-body">

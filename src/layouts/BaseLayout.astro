---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import StructuredData from '../components/StructuredData.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PreFooter from '../components/PreFooter.astro';
import SparkableHead from '@sparkable-cms/cms/runtime/SparkableHead.astro';
import SparkableFooter from '@sparkable-cms/cms/runtime/SparkableFooter.astro';
import { readSiteSettings } from '@sparkable-cms/cms/runtime';
import { clinic, openingHoursSpecification } from '../data/clinic';
interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  showMobileBar?: boolean;
  showPreFooter?: boolean;
  showHeader?: boolean;
  showFooter?: boolean;
  mobileRequestHref?: string;
}

// CMS-managed site settings (analytics scripts, noindex, default SEO). The
// file is absent on a fresh install, so readSiteSettings() returns empty
// defaults and the hard-coded fallbacks below remain in force.
const siteSettings = readSiteSettings();

const {
  title,
  description = siteSettings.defaultDescription
    ?? `Able Family Dental offers family dentistry and implants in Lethbridge, AB. We welcome new patients of all ages, call ${clinic.phoneDisplay} to book.`,
  image = siteSettings.defaultOgImage ?? '/images/og-default.jpg',
  noindex = false,
  showMobileBar = true,
  showPreFooter = true,
  showHeader = true,
  showFooter = true,
  mobileRequestHref = '/book/',
} = Astro.props;

const siteURL = Astro.site ?? new URL('https://ablefamilydental.com/');
const siteRoot = new URL('/', siteURL).href;
const organizationId = 'https://ablefamilydental.com/#organization';
const websiteId = 'https://ablefamilydental.com/#website';
const dentistId = 'https://ablefamilydental.com/#dentist';
const logoURL = new URL('/images/logos/able-family-dental-logo.webp', siteURL).href;
const ogImageURL = new URL(image.startsWith('http') ? image : image, siteURL).href;
const pageURL = new URL(Astro.url.pathname, siteURL).href;

const labelFromSegment = (seg: string) =>
  seg
    .split('-')
    .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
    .join(' ');

const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'Home', item: siteRoot },
  ...pathSegments.map((seg, i) => ({
    '@type': 'ListItem',
    position: i + 2,
    name: labelFromSegment(seg),
    item: new URL('/' + pathSegments.slice(0, i + 1).join('/') + '/', siteURL).href,
  })),
];

const businessData = {
  '@id': dentistId,
  name: clinic.name,
  url: siteRoot,
  telephone: clinic.phoneSchema,
  email: clinic.email,
  image: ogImageURL,
  logo: logoURL,
  parentOrganization: { '@id': organizationId },
  address: {
    '@type': 'PostalAddress',
    streetAddress: clinic.streetAddress,
    addressLocality: clinic.city,
    addressRegion: clinic.regionAbbr,
    postalCode: clinic.postalCode,
    addressCountry: clinic.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 49.6922,
    longitude: -112.8422,
  },
  openingHoursSpecification,
  areaServed: [
    { '@type': 'City', name: clinic.city },
    { '@type': 'AdministrativeArea', name: 'Alberta' },
  ],
  medicalSpecialty: 'https://schema.org/Dentistry',
  priceRange: '$$',
  hasMap: 'https://maps.app.goo.gl/pAJAeiNddySjEkKc8',
  sameAs: [
    'https://www.facebook.com/ablefamilydental',
    'https://www.instagram.com/ablefamilydental/',
    'https://maps.app.goo.gl/pAJAeiNddySjEkKc8',
  ],
};

const organizationData = {
  '@id': organizationId,
  name: clinic.name,
  url: siteRoot,
  logo: logoURL,
  image: ogImageURL,
  telephone: clinic.phoneSchema,
  email: clinic.email,
  sameAs: [
    'https://www.facebook.com/ablefamilydental',
    'https://www.instagram.com/ablefamilydental/',
    'https://maps.app.goo.gl/pAJAeiNddySjEkKc8',
  ],
};

const websiteData = {
  '@id': websiteId,
  name: 'Able Family Dental',
  url: siteRoot,
  publisher: { '@id': organizationId },
  inLanguage: 'en-CA',
  potentialAction: {
    '@type': 'ReserveAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://ablefamilydental.com/book/',
      actionPlatform: [
        'http://schema.org/DesktopWebPlatform',
        'http://schema.org/MobileWebPlatform',
      ],
    },
    result: {
      '@type': 'Reservation',
      name: 'Dental appointment request',
    },
  },
};

const webPageData = {
  '@id': `${pageURL}#webpage`,
  name: title,
  description,
  url: pageURL,
  isPartOf: { '@id': websiteId },
  about: { '@id': dentistId },
  inLanguage: 'en-CA',
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImageURL },
};

const breadcrumbData = {
  itemListElement: breadcrumbItems,
};
---

<!doctype html>
<html lang="en-CA">
  <head>
    <!-- Google Tag Manager (includes GA4 G-GDKQJSMBLW + Meta Pixel 989509751248688) -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-NHTJF68');
    </script>

    <!-- Patient Prism -->
    <script
      is:inline
      async
      src="https://next-api.patientprism.com/v1/snippet/a1f15e1f-9604-45e9-a349-4f8c9f96c08d"
    ></script>

    <!-- Optional MaxAssist booking launcher (kept disabled while /book/ uses direct RecallMax embed). -->
    <!-- <script src="https://cdn.maxassist.com/scripts/maxassist-booking.js" data-server-url="https://can3.recallmax.com/rsm/request/public/bookOnline/patient/layout.html?a=t4ttSwyQ0NkQv9DLpa1kYRBbE_cNvZb54X" is:inline></script> -->

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <meta name="theme-color" content="#008080" />

    <SEOHead
      title={title}
      description={description}
      image={image}
      noindex={noindex}
    />

    <StructuredData type="Organization" data={organizationData} />
    <StructuredData type="WebSite" data={websiteData} />
    <StructuredData type="Dentist" data={businessData} />
    <StructuredData type="WebPage" data={webPageData} />
    {pathSegments.length > 0 && (
      <StructuredData type="BreadcrumbList" data={breadcrumbData} />
    )}

    <!-- CMS-managed head: noindex toggle + editor-added header scripts.
         Renders nothing until an editor configures them. -->
    <SparkableHead />
  </head>
  <body class="font-body text-[var(--color-text)] bg-[var(--color-surface)] antialiased overflow-x-hidden">
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-NHTJF68"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
        title="Google Tag Manager"
      ></iframe>
    </noscript>

    <a href="#main" class="skip-link">Skip to main content</a>

    {showHeader && <Header />}

    <main id="main">
      <slot />
    </main>

    {showPreFooter && <PreFooter />}

    {showFooter && <Footer />}

    {showMobileBar && (
      <div class="md:hidden fixed bottom-0 inset-x-0 z-40 grid grid-cols-2 border-t border-[var(--color-border)] bg-white shadow-[0_-4px_16px_rgba(30,51,82,0.10)]" aria-label="Quick contact actions">
        <a href="tel:+14033277202" class="flex items-center justify-center gap-2 py-3.5 text-[var(--color-brand-primary)] font-semibold border-r border-[var(--color-border)]">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Call
        </a>
        <a href={mobileRequestHref} class="flex items-center justify-center gap-2 py-3.5 bg-[var(--color-brand-accent-btn)] text-white font-semibold">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Request
        </a>
      </div>
      <div class="md:hidden h-16" aria-hidden="true"></div>
    )}

    <div
      id="cookie-consent-banner"
      class="fixed inset-x-0 bottom-0 z-[70] border-t border-[var(--color-border)] bg-white/98 backdrop-blur p-4 shadow-[0_-6px_20px_rgba(30,51,82,0.14)]"
      hidden
      role="dialog"
      aria-live="polite"
      aria-label="Cookie consent"
    >
      <div class="container-wide flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
        <p class="text-sm text-[var(--color-text)] leading-relaxed">
          We use cookies for analytics and site functionality. By continuing, you accept our use of cookies.
          <a href="/privacy/" class="font-semibold text-[var(--color-brand-accent)] hover:text-[var(--color-brand-accent-hover)]">Learn more</a>.
        </p>
        <button
          id="cookie-consent-accept"
          type="button"
          class="btn btn-primary whitespace-nowrap"
        >
          Accept cookies
        </button>
      </div>
    </div>

    <script is:inline>
      (() => {
        const key = 'afd_cookie_consent_v1';
        const banner = document.getElementById('cookie-consent-banner');
        const accept = document.getElementById('cookie-consent-accept');
        if (!banner || !accept) return;

        try {
          const existing = localStorage.getItem(key);
          if (existing === 'accepted') return;
        } catch {
          // If storage is unavailable, still show banner for this visit.
        }

        banner.hidden = false;
        accept.addEventListener('click', () => {
          try {
            localStorage.setItem(key, 'accepted');
          } catch {
            // Ignore storage errors and still dismiss.
          }
          banner.hidden = true;
        });
      })();
    </script>

    <!-- CMS-managed footer scripts. Renders nothing until an editor adds them. -->
    <SparkableFooter />
  </body>
</html>
